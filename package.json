{
  "name": "shipherd",
  "version": "4.2.2",
  "private": true,
  "description": "One coordinator for all your Claude Code sessions",
  "author": "Yuchen Lin",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/build-memory-mcp.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-memory-mcp.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "build:hook": "node scripts/build-hook.mjs",
    "build:memory-mcp": "node scripts/build-memory-mcp.mjs",
    "icons": "electron scripts/render-icons.mjs",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "pree2e": "pnpm build && pnpm build:hook",
    "e2e": "playwright test",
    "e2e:only": "playwright test",
    "postinstall": "electron-builder install-app-deps",
    "demo:record": "pnpm build && pnpm build:hook && pnpm demo:record:only",
    "demo:record:only": "playwright test -c playwright.demo.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty",
      "esbuild"
    ],
    "overrides": {
      "hono": "4.13.18",
      "@hono/node-server": "2.1.8",
      "body-parser": "2.4.0",
      "zod": "4.6.7"
    }
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "cross-spawn": "7.0.6",
    "node-pty": "1.1.0",
    "statecore-mcp": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "happy-dom": "20.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
